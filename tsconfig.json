
{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Module Resolution */
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Paths - Ensure base is root */
    "baseUrl": "./",
    "paths": {
      "*": ["*"]
    },

    /* Strictness */
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "vite-env.d.ts",
    "types.ts",
    "constants.ts",
    "supabase.ts",
    "index.tsx",
    "App.tsx",
    "components/**/*.tsx",
    "components/**/*.ts",
    "services/**/*.ts",
    "hooks/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
